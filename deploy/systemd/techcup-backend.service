# systemd unit for the TechCup Fútbol backend (Spring Boot jar).
# Install: see DEPLOY.md. Configuration (secrets included) comes from /etc/techcup/backend.env.

[Unit]
Description=TechCup Futbol backend (Spring Boot)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=techcup
Group=techcup
WorkingDirectory=/opt/techcup
EnvironmentFile=/etc/techcup/backend.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/techcup/techcup.jar
# The JVM exits with 143 on SIGTERM after a graceful shutdown; that is a clean stop.
SuccessExitStatus=143
TimeoutStopSec=40
Restart=on-failure
RestartSec=10
# Hardening: the process only needs to read its jar and write logs to the journal.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
