# Environment for the TechCup backend when it runs natively under systemd.
# Copy to /etc/techcup/backend.env, fill in every <...> value and protect it:
#   sudo chown root:techcup /etc/techcup/backend.env && sudo chmod 640 /etc/techcup/backend.env
# The "prod" profile refuses to start while JWT_SECRET or ADMIN_PASSWORD keep their
# development defaults, and disables Swagger.

SPRING_PROFILES_ACTIVE=prod

# Listen only on localhost: nginx is the single public entry point.
SERVER_ADDRESS=127.0.0.1
PORT=8080

# PostgreSQL started by `docker compose up -d` (host port 5433). DB_PASSWORD must equal the
# DB_PASSWORD in the repository's .env used by docker compose.
DB_URL=jdbc:postgresql://127.0.0.1:5433/techcup
DB_USER=techcup
DB_PASSWORD=<same value as DB_PASSWORD in the repo .env>

# MongoDB started by `docker compose up -d` (host port 27018), with the root user created from
# MONGO_USER / MONGO_PASSWORD in the repo .env on the FIRST start of its volume.
# Use a hexadecimal password (openssl rand -hex 24): '/', '@' or ':' would break this URL.
MONGO_URI=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@127.0.0.1:27018/techcup?authSource=admin

# At least 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=<random secret>
JWT_EXPIRATION_MINUTES=480

# The administrator is created on the first start when no ADMIN user exists yet.
ADMIN_EMAIL=<admin e-mail>
ADMIN_PASSWORD=<strong password>

# Public URL of the site (scheme + host, no trailing slash).
CORS_ORIGINS=https://<your domain or http://server-ip>

APP_TIME_ZONE=America/Bogota
TZ=America/Bogota
