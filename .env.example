# Copy this file to .env (git-ignored) before running the full stack:
#   docker compose --profile app up -d --build      (or start.bat / start.sh)
# The backend runs with the "prod" Spring profile there and refuses to start while
# JWT_SECRET or ADMIN_PASSWORD keep their development defaults.
#
# Plain `docker compose up -d` (databases only, for native development) does not need this file.

# HS256 signing key for the JWTs. At least 32 random bytes; generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Administrator created on the first start (when no ADMIN user exists yet).
ADMIN_EMAIL=admin@escuelaing.edu.co
ADMIN_PASSWORD=

# PostgreSQL password (user "techcup", database "techcup").
DB_PASSWORD=techcup

# MongoDB root credentials (GridFS). Changing them requires a fresh volume: docker compose down -v
MONGO_USER=techcup
MONGO_PASSWORD=techcup

# Zone for every date rule (tournament start/end, 18:00 kick-offs).
APP_TIME_ZONE=America/Bogota
